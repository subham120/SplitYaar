# SplitYaar Backend Environment Variables

# MongoDB Atlas connection string
# Replace with your Atlas URI: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/splityaar?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://your_user:your_password@your_cluster.mongodb.net/splityaar?retryWrites=true&w=majority

# Server port
PORT=5000

# JWT secret — change this to a long random string in production
JWT_SECRET=splityaar_super_secret_key_change_me

# JWT expiry
JWT_EXPIRES_IN=30d
