---
import Layout from '../../../layouts/Layout.astro';
import SubNav from '../../../components/SubNav.astro';
import { getTripByCode } from '../../../lib/store';
import { formatINR, formatISTDate } from '../../../lib/format';
import { computeNetBalances, simplifyDebts } from '../../../lib/settlement';
import { buildUpiLink, generateQrCodeDataUrl } from '../../../lib/upi';

const { code } = Astro.params;

if (!code) {
  return Astro.redirect('/');
}

const tripData = await getTripByCode(code);
if (!tripData) {
  return Astro.redirect('/');
}

const { trip, members, expenses, shares, settlements } = tripData;
const netBalances = computeNetBalances(members, expenses, shares, settlements);
const rawTransactions = simplifyDebts(netBalances);

// Enrich transactions with member details, UPI links, and QR codes
const transactions = await Promise.all(
  rawTransactions.map(async (t) => {
    const fromMember = members.find((m) => m.id === t.fromMemberId);
    const toMember = members.find((m) => m.id === t.toMemberId);

    const fromName = fromMember?.name ?? 'Unknown';
    const toName = toMember?.name ?? 'Unknown';
    const toUpiId = toMember?.upiId ?? null;

    let upiLink = '';
    let qrDataUrl = '';

    if (toUpiId) {
      upiLink = buildUpiLink(
        toUpiId,
        toName,
        t.amountPaise,
        `Settle up: ${trip.name}`
      );
      try {
        qrDataUrl = await generateQrCodeDataUrl(upiLink);
      } catch (e) {
        console.error('QR code generation failed for settlement', e);
      }
    }

    return {
      ...t,
      fromName,
      toName,
      toUpiId,
      upiLink,
      qrDataUrl,
    };
  })
);
---

<Layout title={`Settle Up — ${trip.name}`} noindex={true}>
  <!-- Identity Redirect Script (run immediately to block FOUC) -->
  <script define:vars={{ code }}>
    if (!localStorage.getItem(`split_yatra_member_${code}`)) {
      window.location.replace(`/trip/${code}/join`);
    }
  </script>

  <!-- Frosted SubNav -->
  <SubNav code={code} activeTab="settlement" tripName={trip.name} />

  <div class="bg-canvas-parchment min-h-[90vh] pb-20 pt-3 sm:pt-lg px-3.5 sm:px-lg">
    <div class="max-w-[640px] w-full mx-auto space-y-3.5 sm:space-y-lg">
      
      {transactions.length === 0 ? (
        <!-- Happy settled state -->
        <div class="bg-white border border-hairline rounded-lg p-6 sm:p-xxl text-center flex flex-col items-center justify-center min-h-[320px] shadow-sm select-none">
          <span class="text-[52px] sm:text-[64px] block mb-sm">🎉</span>
          <h2 class="text-[24px] sm:text-display-md font-display font-semibold text-ink tracking-tight mb-xs">
            Everyone is Settled!
          </h2>
          <p class="text-caption sm:text-lead text-ink-muted-48 leading-relaxed max-w-[400px]">
            No outstanding balances remain. All debts have been squared away.
          </p>
          <a
            href={`/trip/${code}`}
            class="mt-lg bg-primary text-on-primary font-sans font-semibold text-body px-xl py-2.5 rounded-pill hover:bg-primary-focus active:scale-95 transition-all select-none cursor-pointer shadow-xs"
          >
            Go to Dashboard
          </a>
        </div>
      ) : (
        <!-- Debts List -->
        <div class="space-y-sm">
          <div class="bg-white border border-hairline rounded-lg p-4 sm:p-lg shadow-sm">
            <h2 class="text-body-strong font-semibold text-ink mb-1">Settlement Plan</h2>
            <p class="text-caption text-ink-muted-48 leading-relaxed mb-4">
              We've calculated the minimum transfers required to settle all debts.
            </p>

            <div class="space-y-3">
              {transactions.map((tx, idx) => {
                return (
                  <div
                    class="settlement-row bg-surface-pearl border border-hairline rounded-lg p-3.5 sm:p-md flex flex-col sm:flex-row sm:items-center justify-between gap-3 transition-all"
                    data-tx-idx={idx}
                  >
                    <!-- Debtor and Creditor info -->
                    <div class="truncate flex-1">
                      <div class="flex items-center gap-1.5 text-[15px] sm:text-body-strong text-ink font-semibold flex-wrap">
                        <span class="truncate max-w-[140px] xs:max-w-none">{tx.fromName}</span>
                        <span class="text-zinc-400 font-normal">&rarr;</span>
                        <span class="truncate max-w-[140px] xs:max-w-none text-primary">{tx.toName}</span>
                      </div>
                      <span class="text-caption text-ink-muted-48 block mt-1">
                        Amount: <span class="font-bold text-ink tabular-nums">{formatINR(tx.amountPaise)}</span>
                      </span>
                    </div>

                    <!-- Actions -->
                    <div class="flex items-center gap-2 shrink-0 self-end sm:self-auto">
                      <!-- Record Paid Button (Only enabled for the receiver or admin) -->
                      <div class="relative">
                        <button
                          type="button"
                          class="record-payment-btn border border-emerald-600/80 bg-emerald-50 text-emerald-700 hover:bg-emerald-100 active:scale-95 text-[12px] font-sans font-semibold px-3 py-1.5 rounded-pill transition-all cursor-pointer flex items-center gap-1 select-none shrink-0"
                          data-from-id={tx.fromMemberId}
                          data-to-id={tx.toMemberId}
                          data-from-name={tx.fromName}
                          data-to-name={tx.toName}
                          data-amount-paise={tx.amountPaise}
                          data-amount-str={formatINR(tx.amountPaise)}
                          title={`Only ${tx.toName} can confirm receiving this payment`}
                        >
                          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                          <span class="record-btn-text">Mark Received</span>
                        </button>
                      </div>

                      <!-- Pay Button (Mobile UPI or desktop modal launcher) -->
                      {tx.toUpiId ? (
                        <button
                          type="button"
                          class="pay-btn bg-primary text-on-primary text-[12px] font-sans font-semibold px-3.5 py-1.5 rounded-pill hover:bg-primary-focus active:scale-95 transition-all select-none cursor-pointer shrink-0 shadow-xs"
                          data-upi-link={tx.upiLink}
                          data-qr-url={tx.qrDataUrl}
                          data-payee={tx.toName}
                          data-amount={formatINR(tx.amountPaise)}
                        >
                          Pay UPI
                        </button>
                      ) : (
                        <button
                          type="button"
                          class="nudge-btn border border-primary text-primary text-[12px] font-sans font-medium px-3.5 py-1.5 rounded-pill hover:bg-zinc-50 active:scale-95 transition-all select-none cursor-pointer shrink-0"
                          data-payee-name={tx.toName}
                        >
                          Nudge UPI
                        </button>
                      )}
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        </div>
      )}

      <!-- Past Recorded Settlements (if any) -->
      {settlements.length > 0 && (
        <div class="bg-white border border-hairline rounded-lg p-4 sm:p-lg shadow-sm">
          <h2 class="text-body-strong font-semibold text-ink mb-1">Recorded Settlements</h2>
          <p class="text-caption text-ink-muted-48 leading-relaxed mb-md">
            Direct peer-to-peer repayments confirmed in this trip.
          </p>

          <div class="space-y-sm">
            {settlements.map((s) => {
              const fromM = members.find((m) => m.id === s.fromMemberId);
              const toM = members.find((m) => m.id === s.toMemberId);
              const fromName = fromM?.name ?? 'Unknown';
              const toName = toM?.name ?? 'Unknown';

              return (
                <div class="flex items-center justify-between p-sm bg-emerald-50/60 border border-emerald-200/60 rounded-md">
                  <div class="truncate pr-sm">
                    <div class="text-body-strong text-ink font-semibold flex items-center gap-xs">
                      <span>{fromName}</span>
                      <span class="text-emerald-600 font-normal">&rarr;</span>
                      <span class="text-emerald-700">{toName}</span>
                    </div>
                    <span class="text-fine-print text-ink-muted-48 block mt-[2px]">
                      Confirmed on {formatISTDate(s.date)}
                    </span>
                  </div>
                  <div class="text-right shrink-0">
                    <span class="text-body-strong font-bold text-emerald-700 tabular-nums block">
                      {formatINR(s.amountPaise)}
                    </span>
                    <span class="text-[10px] uppercase font-bold text-emerald-800 bg-emerald-100 px-[6px] py-[2px] rounded-xs inline-block mt-[2px]">
                      Settled ✓
                    </span>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      )}

    </div>
  </div>

  <!-- Confirm Settlement Payment Modal -->
  <div 
    id="confirm-settle-modal" 
    class="hidden fixed inset-0 bg-black/60 backdrop-blur-xs flex items-center justify-center z-50 p-lg"
    role="dialog"
    aria-modal="true"
    aria-labelledby="confirm-settle-title"
  >
    <div class="bg-white border border-hairline rounded-lg p-lg max-w-[380px] w-full text-center flex flex-col items-center shadow-2xl relative animate-fadeIn">
      <!-- Close button inside modal -->
      <button 
        id="close-confirm-settle-btn"
        aria-label="Close modal"
        class="absolute right-md top-md w-8 h-8 rounded-full bg-zinc-100 hover:bg-zinc-200 text-ink flex items-center justify-center active:scale-90 transition-all select-none cursor-pointer"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
      </button>

      <div class="w-12 h-12 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center text-xl mb-sm font-bold">
        ✓
      </div>
      <h3 id="confirm-settle-title" class="text-body-strong font-semibold text-ink text-[18px] mb-xxs">
        Confirm Payment Received
      </h3>
      <p class="text-caption text-ink-muted-48 mb-md leading-relaxed">
        Verify that you have received this payment via UPI/Cash to officially clear this debt from the trip ledger.
      </p>

      <div class="w-full bg-surface-pearl border border-hairline rounded-md p-md mb-md text-left space-y-xs text-caption">
        <div class="flex items-center justify-between">
          <span class="text-ink-muted-48">Payer:</span>
          <span class="font-semibold text-ink" id="confirm-payer-name">-</span>
        </div>
        <div class="flex items-center justify-between">
          <span class="text-ink-muted-48">Paid To:</span>
          <span class="font-semibold text-ink" id="confirm-receiver-name">-</span>
        </div>
        <div class="flex items-center justify-between text-body font-semibold border-t border-divider-soft pt-xs mt-xs">
          <span class="text-ink">Amount:</span>
          <span class="text-emerald-600 tabular-nums font-bold" id="confirm-settle-amount">-</span>
        </div>
      </div>

      <div class="flex items-center gap-sm w-full">
        <button
          id="cancel-settle-btn"
          type="button"
          class="flex-1 bg-zinc-100 hover:bg-zinc-200 text-ink text-[13px] font-sans font-medium py-[9px] px-md rounded-pill transition-all cursor-pointer"
        >
          Cancel
        </button>
        <button
          id="submit-settle-btn"
          type="button"
          class="flex-1 bg-emerald-600 hover:bg-emerald-700 text-white text-[13px] font-sans font-semibold py-[9px] px-md rounded-pill transition-all cursor-pointer flex items-center justify-center gap-xs shadow-xs"
        >
          <span id="submit-settle-btn-text">Confirm & Settle</span>
        </button>
      </div>
      <p id="confirm-settle-error" class="hidden text-caption text-red-600 bg-red-50 border border-red-200 rounded-sm p-xs mt-xs w-full text-center"></p>
    </div>
  </div>

  <!-- QR Code Modal (Desktop QR scanning visual popup) -->
  <div id="qr-modal" class="hidden fixed inset-0 bg-black/60 backdrop-blur-xs flex items-center justify-center z-50 p-lg">
    <div class="bg-white border border-hairline rounded-lg p-lg max-w-[360px] w-full text-center flex flex-col items-center shadow-2xl relative animate-fadeIn">
      <!-- Close button inside modal -->
      <button 
        id="close-modal-btn"
        aria-label="Close modal"
        class="absolute right-md top-md w-8 h-8 rounded-full bg-zinc-100 hover:bg-zinc-200 text-ink flex items-center justify-center active:scale-90 transition-all select-none cursor-pointer"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
      </button>
      
      <h3 class="text-body-strong font-semibold text-ink mb-xxs" id="modal-payee-title">Pay Friend</h3>
      <p class="text-caption text-ink-muted-48 mb-md" id="modal-amount-title">Amount: ₹0.00</p>
      
      <!-- QR Image slot -->
      <div class="bg-zinc-50 border border-hairline rounded-md p-sm mb-md w-[240px] h-[240px] flex items-center justify-center">
        <img id="modal-qr-img" src="" alt="UPI Payment QR Code" class="w-full h-full object-contain" />
      </div>
      
      <p class="text-fine-print text-ink-muted-48 leading-relaxed max-w-[280px]">
        Scan this QR code with any UPI app (GPay, PhonePe, Paytm) to make payment.
      </p>
    </div>
  </div>

  <!-- Client-side Interactive Modal, Settle Recording & Nudge actions -->
  <script define:vars={{ code, tripCreatorId: trip.createdByMemberId }}>
    // Retrieve current logged in member identity from localStorage
    const currentMemberId = localStorage.getItem(`split_yatra_member_${code}`);
    // Confirm Settlement Modal & Recording Logic
    const confirmModal = document.getElementById('confirm-settle-modal');
    const closeConfirmBtn = document.getElementById('close-confirm-settle-btn');
    const cancelConfirmBtn = document.getElementById('cancel-settle-btn');
    const submitSettleBtn = document.getElementById('submit-settle-btn');
    const submitSettleBtnText = document.getElementById('submit-settle-btn-text');
    const confirmPayerName = document.getElementById('confirm-payer-name');
    const confirmReceiverName = document.getElementById('confirm-receiver-name');
    const confirmSettleAmount = document.getElementById('confirm-settle-amount');
    const confirmSettleError = document.getElementById('confirm-settle-error');

    let activeSettleData = null;

    function openConfirmModal(data) {
      activeSettleData = data;
      if (confirmPayerName) confirmPayerName.textContent = data.fromName;
      if (confirmReceiverName) confirmReceiverName.textContent = data.toName;
      if (confirmSettleAmount) confirmSettleAmount.textContent = data.amountStr;
      if (confirmSettleError) confirmSettleError.classList.add('hidden');
      if (submitSettleBtn) submitSettleBtn.disabled = false;
      if (submitSettleBtnText) submitSettleBtnText.textContent = 'Confirm & Settle';
      if (confirmModal) confirmModal.classList.remove('hidden');
    }

    function closeConfirmModal() {
      if (confirmModal) confirmModal.classList.add('hidden');
      activeSettleData = null;
    }

    if (closeConfirmBtn) closeConfirmBtn.addEventListener('click', closeConfirmModal);
    if (cancelConfirmBtn) cancelConfirmBtn.addEventListener('click', closeConfirmModal);
    if (confirmModal) {
      confirmModal.addEventListener('click', (e) => {
        if (e.target === confirmModal) closeConfirmModal();
      });
    }

    // Adapt Settlement buttons based on current member identity (Receiver-Only authenticity)
    const settleButtons = document.querySelectorAll('.record-payment-btn');
    settleButtons.forEach((btn) => {
      const toId = btn.getAttribute('data-to-id');
      const fromId = btn.getAttribute('data-from-id');
      const toName = btn.getAttribute('data-to-name') || 'the recipient';

      const isReceiver = currentMemberId && currentMemberId === toId;
      const isCreator = currentMemberId && currentMemberId === tripCreatorId;
      const isPayer = currentMemberId && currentMemberId === fromId;

      const textSpan = btn.querySelector('.record-btn-text');

      if (isReceiver || isCreator) {
        // Authorized recipient: Can confirm & settle
        btn.classList.add('cursor-pointer');
        btn.setAttribute('title', `Confirm you received this payment`);
        if (textSpan) textSpan.textContent = 'Mark Received';
      } else if (isPayer) {
        // Debtor/Payer: Cannot self-clear the debt! Must be confirmed by receiver
        btn.classList.remove('bg-emerald-50', 'text-emerald-700', 'border-emerald-600/80', 'hover:bg-emerald-100');
        btn.classList.add('bg-zinc-100', 'text-zinc-500', 'border-zinc-300', 'hover:bg-zinc-100');
        btn.setAttribute('data-disabled-role', 'payer');
        btn.setAttribute('title', `Only ${toName} can confirm receiving this payment`);
        if (textSpan) textSpan.textContent = 'Confirm Pending';
      } else {
        // Non-participating third-party member
        btn.classList.remove('bg-emerald-50', 'text-emerald-700', 'border-emerald-600/80', 'hover:bg-emerald-100');
        btn.classList.add('bg-zinc-100', 'text-zinc-500', 'border-zinc-300', 'hover:bg-zinc-100');
        btn.setAttribute('data-disabled-role', 'viewer');
        btn.setAttribute('title', `Only ${toName} can confirm receiving this payment`);
        if (textSpan) textSpan.textContent = 'Mark Received';
      }
    });

    // Click on Record Paid / Mark Received button
    document.addEventListener('click', (e) => {
      const btn = e.target.closest('.record-payment-btn');
      if (!btn) return;

      const disabledRole = btn.getAttribute('data-disabled-role');
      const toName = btn.getAttribute('data-to-name') || 'the recipient';

      if (disabledRole === 'payer') {
        alert(`Authenticity Notice: Only ${toName} can confirm receiving your payment. Once you pay via UPI/cash, ask ${toName} to click 'Mark Received'.`);
        return;
      }

      if (disabledRole === 'viewer') {
        alert(`Only ${toName} (the recipient) or the trip admin can confirm receiving this payment.`);
        return;
      }

      const fromMemberId = btn.getAttribute('data-from-id');
      const toMemberId = btn.getAttribute('data-to-id');
      const fromName = btn.getAttribute('data-from-name') || '';
      const amountPaise = parseInt(btn.getAttribute('data-amount-paise') || '0', 10);
      const amountStr = btn.getAttribute('data-amount-str') || '';

      if (fromMemberId && toMemberId && amountPaise > 0) {
        openConfirmModal({
          fromMemberId,
          toMemberId,
          fromName,
          toName,
          amountPaise,
          amountStr,
        });
      }
    });

    if (submitSettleBtn) {
      submitSettleBtn.addEventListener('click', async () => {
        if (!activeSettleData) return;

        submitSettleBtn.disabled = true;
        if (submitSettleBtnText) submitSettleBtnText.textContent = 'Recording…';
        if (confirmSettleError) confirmSettleError.classList.add('hidden');

        try {
          const res = await fetch(`/api/trips/${code}/settlement`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              fromMemberId: activeSettleData.fromMemberId,
              toMemberId: activeSettleData.toMemberId,
              amountPaise: activeSettleData.amountPaise,
              recordedByMemberId: currentMemberId || undefined,
            }),
          });

          const result = await res.json();
          if (!res.ok) {
            throw new Error(result.error || 'Failed to record settlement');
          }

          // Reload page to reflect cleared debt and show "Everyone is Settled!"
          window.location.reload();
        } catch (err) {
          submitSettleBtn.disabled = false;
          if (submitSettleBtnText) submitSettleBtnText.textContent = 'Confirm & Settle';
          if (confirmSettleError) {
            confirmSettleError.textContent = (err && err.message) ? err.message : 'Failed to record payment';
            confirmSettleError.classList.remove('hidden');
          }
        }
      });
    }

    // Pay UPI actions (Mobile vs Desktop)
    const modal = document.getElementById('qr-modal');
    const modalQr = document.getElementById('modal-qr-img');
    const modalPayee = document.getElementById('modal-payee-title');
    const modalAmount = document.getElementById('modal-amount-title');
    const closeModalBtn = document.getElementById('close-modal-btn');

    function isMobile() {
      return /Android|iPhone|iPad|iPod|Opera Mini|IEMobile/i.test(navigator.userAgent);
    }

    document.addEventListener('click', (e) => {
      const btn = e.target.closest('.pay-btn');
      if (!btn) return;

      const upiLink = btn.getAttribute('data-upi-link') || '';
      const qrUrl = btn.getAttribute('data-qr-url') || '';
      const payeeName = btn.getAttribute('data-payee') || '';
      const amountStr = btn.getAttribute('data-amount') || '';

      if (isMobile()) {
        // Open deep link directly on mobile
        window.location.href = upiLink;
      } else {
        // Show QR modal on desktop
        if (modal && modalQr && modalPayee && modalAmount) {
          modalQr.src = qrUrl;
          modalPayee.textContent = `Pay ${payeeName}`;
          modalAmount.textContent = `Amount: ${amountStr}`;
          modal.classList.remove('hidden');
        }
      }
    });

    // Close modal triggers
    if (closeModalBtn && modal) {
      closeModalBtn.addEventListener('click', () => {
        modal.classList.add('hidden');
      });
      modal.addEventListener('click', (e) => {
        if (e.target === modal) {
          modal.classList.add('hidden');
        }
      });
    }

    // Nudge UPI Actions (nudge missing payee UPI configurations)
    document.addEventListener('click', (e) => {
      const btn = e.target.closest('.nudge-btn');
      if (!btn) return;

      const payeeName = btn.getAttribute('data-payee-name') || '';
      const text = encodeURIComponent(
        `Hey ${payeeName}! Please add your UPI ID on SplitYatra so I can settle our trip debts: ${window.location.href}`
      );
      window.open(`https://api.whatsapp.com/send?text=${text}`, '_blank');
    });
  </script>
</Layout>

