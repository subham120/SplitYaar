---
import Layout from '../../../layouts/Layout.astro';
import SubNav from '../../../components/SubNav.astro';
import { getTripByCode } from '../../../lib/store';
import { formatINR } from '../../../lib/format';
import { computeNetBalances } from '../../../lib/settlement';

const { code } = Astro.params;

if (!code) {
  return Astro.redirect('/');
}

const tripData = await getTripByCode(code);
if (!tripData) {
  return Astro.redirect('/');
}

const { trip, members, expenses, shares } = tripData;
const netBalances = computeNetBalances(members, expenses, shares);
---

<Layout title={`Manage Members — ${trip.name}`} noindex={true}>
  <!-- Identity Redirect Script (run immediately to block FOUC) -->
  <script define:vars={{ code }}>
    if (!localStorage.getItem(`split_yatra_member_${code}`)) {
      window.location.replace(`/trip/${code}/join`);
    }
  </script>

  <!-- Frosted SubNav -->
  <SubNav code={code} activeTab="members" tripName={trip.name} />

  <div class="bg-canvas-parchment min-h-[90vh] pb-20 pt-3 sm:pt-lg px-3.5 sm:px-lg">
    <div class="max-w-[1440px] w-full mx-auto grid grid-cols-1 lg:grid-cols-3 gap-3.5 sm:gap-lg">
      
      <!-- Left 2 Columns: Members List & UPI configuration -->
      <div class="lg:col-span-2 space-y-3 sm:space-y-md">
        <!-- Error Alert box -->
        <div id="members-alert-box" class="hidden bg-red-50 border border-red-200 rounded-md p-md text-caption text-red-600 animate-fadeIn">
        </div>

        <div class="bg-white border border-hairline rounded-lg p-4 sm:p-lg shadow-sm">
          <h2 class="text-body-strong font-semibold text-ink mb-4 sm:mb-lg">Group Members</h2>
          
          <div class="space-y-4 sm:space-y-lg" id="members-list-container">
            {members.map((m) => {
              const mBal = netBalances.find((b) => b.memberId === m.id);
              const balancePaise = mBal ? mBal.netBalancePaise : 0;
              
              let balText = 'Settled up';
              let balClass = 'text-ink-muted-48 tabular-nums';
              if (balancePaise > 0) {
                balText = `Owed: ${formatINR(balancePaise)}`;
                balClass = 'text-green-600 font-semibold tabular-nums';
              } else if (balancePaise < 0) {
                balText = `Owes: ${formatINR(Math.abs(balancePaise))}`;
                balClass = 'text-red-500 font-semibold tabular-nums';
              }

              return (
                <div 
                  class="member-management-row flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-divider-soft pb-4 sm:pb-lg last:border-0 last:pb-0"
                  data-member-id={m.id}
                  data-member-name={m.name}
                >
                  <!-- Member Name & Net Balance Status -->
                  <div class="flex items-center gap-2.5 min-w-0 flex-1">
                    <div class="w-8 h-8 rounded-full bg-zinc-200/80 text-ink font-bold text-[13px] flex items-center justify-center shrink-0">
                      {m.name.charAt(0).toUpperCase()}
                    </div>
                    <div class="min-w-0 flex-1">
                      <span class="text-[15px] sm:text-body-strong text-ink font-semibold flex items-center gap-1.5 flex-wrap">
                        <span class="truncate max-w-[160px] xs:max-w-[220px] sm:max-w-none">{m.name}</span>
                        <span class="member-you-badge hidden text-fine-print bg-primary text-white px-1.5 py-[1px] rounded-xs text-[10px] font-semibold shrink-0">You</span>
                      </span>
                      <span class={`text-[12px] block mt-0.5 ${balClass}`}>
                        {balText}
                      </span>
                    </div>
                  </div>

                  <!-- UPI Input and Action Options -->
                  <div class="flex items-center gap-2 w-full sm:w-auto">
                    <!-- UPI Form -->
                    <div class="flex items-center gap-1.5 flex-grow sm:flex-grow-0">
                      <div class="relative flex-grow max-w-xs">
                        <span class="absolute left-3 top-1/2 -translate-y-1/2 text-[11px] text-ink-muted-48 font-medium">upi:</span>
                        <input
                          type="text"
                          value={m.upiId || ''}
                          placeholder="username@bank"
                          autocomplete="off"
                          class="upi-input-field w-full bg-surface-pearl text-ink font-sans text-[12.5px] border border-hairline rounded-pill pl-9 pr-2 py-1.5 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 placeholder:text-zinc-300 transition-all"
                        />
                      </div>
                      <button
                        type="button"
                        class="save-upi-btn bg-primary text-on-primary text-[12px] font-sans font-medium px-3 py-1.5 rounded-pill hover:bg-primary-focus active:scale-95 transition-all select-none cursor-pointer shrink-0"
                      >
                        Save
                      </button>
                    </div>

                    <!-- Delete button -->
                    <button
                      type="button"
                      class="remove-member-btn text-[12px] text-red-500 hover:text-red-700 font-medium select-none cursor-pointer transition-colors active:scale-95 shrink-0 px-2 py-1"
                    >
                      Remove
                    </button>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      </div>

      <!-- Right Column: Add Member Form -->
      <div>
        <div class="bg-white border border-hairline rounded-lg p-lg shadow-sm">
          <h2 class="text-body-strong font-semibold text-ink mb-md">Add Member</h2>
          <form id="add-member-form" class="space-y-md">
            <div>
              <label for="new-member-name" class="block text-caption-strong text-ink font-semibold mb-xxs">Name</label>
              <input
                type="text"
                id="new-member-name"
                name="name"
                placeholder="e.g. Sneha"
                required
                maxlength="30"
                autocomplete="name"
                class="w-full bg-canvas text-ink font-sans text-body border border-hairline rounded-pill px-lg py-[9px] focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 placeholder:text-zinc-300 transition-all"
              />
            </div>
            <div>
              <label for="new-member-upi" class="block text-caption-strong text-ink font-semibold mb-xxs">UPI ID (Optional)</label>
              <input
                type="text"
                id="new-member-upi"
                name="upiId"
                placeholder="e.g. sneha@okhdfcbank"
                autocomplete="off"
                class="w-full bg-canvas text-ink font-sans text-body border border-hairline rounded-pill px-lg py-[9px] focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 placeholder:text-zinc-300 transition-all"
              />
            </div>
            <button
              type="submit"
              id="add-btn"
              class="w-full bg-primary text-on-primary font-sans font-medium text-body py-[10px] rounded-pill hover:bg-primary-focus active:scale-95 transition-all select-none cursor-pointer text-center"
            >
              Add Member
            </button>
          </form>
        </div>
      </div>

    </div>
  </div>

  <!-- Remove Member Confirmation Modal -->
  <div 
    id="remove-member-modal" 
    class="hidden fixed inset-0 bg-black/60 backdrop-blur-xs flex items-center justify-center z-50 p-lg"
    role="dialog"
    aria-modal="true"
    aria-labelledby="remove-member-title"
  >
    <div class="bg-white border border-hairline rounded-lg p-lg max-w-[380px] w-full text-center flex flex-col items-center shadow-2xl relative animate-fadeIn">
      <!-- Close button inside modal -->
      <button 
        id="close-remove-member-modal-btn"
        aria-label="Close modal"
        class="absolute right-md top-md w-8 h-8 rounded-full bg-zinc-100 hover:bg-zinc-200 text-ink flex items-center justify-center active:scale-90 transition-all select-none cursor-pointer"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
      </button>

      <div class="w-12 h-12 rounded-full bg-red-100 text-red-600 flex items-center justify-center text-xl mb-sm font-bold">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="17" x2="22" y1="8" y2="13"/><line x1="22" x2="17" y1="8" y2="13"/></svg>
      </div>
      <h3 id="remove-member-title" class="text-body-strong font-semibold text-ink text-[18px] mb-xxs">
        Remove Member?
      </h3>
      <p id="remove-member-desc" class="text-caption text-ink-muted-48 mb-lg leading-relaxed">
        Are you sure you want to remove this member from the trip?
      </p>

      <div class="flex items-center gap-sm w-full">
        <button
          id="cancel-remove-member-btn"
          type="button"
          class="flex-1 bg-zinc-100 hover:bg-zinc-200 text-ink text-[13px] font-sans font-medium py-[10px] px-md rounded-pill transition-all cursor-pointer select-none"
        >
          Cancel
        </button>
        <button
          id="confirm-remove-member-btn"
          type="button"
          class="flex-1 bg-red-600 hover:bg-red-700 text-white text-[13px] font-sans font-semibold py-[10px] px-md rounded-pill transition-all cursor-pointer flex items-center justify-center gap-xs shadow-xs select-none"
        >
          <span id="confirm-remove-member-btn-text">Remove</span>
        </button>
      </div>
      <p id="remove-member-modal-error" class="hidden text-caption text-red-600 bg-red-50 border border-red-200 rounded-sm p-xs mt-xs w-full text-center"></p>
    </div>
  </div>

  <script define:vars={{ code }}>
    const currentMemberId = localStorage.getItem(`split_yatra_member_${code}`);
    const alertBox = document.getElementById('members-alert-box');
    const addForm = document.getElementById('add-member-form');
    const addBtn = document.getElementById('add-btn');
    const membersList = document.getElementById('members-list-container');

    // Show alert helper
    function showAlert(text) {
      if (!alertBox) return;
      alertBox.textContent = text;
      alertBox.classList.remove('hidden');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // Hide alert helper
    function hideAlert() {
      if (alertBox) alertBox.classList.add('hidden');
    }

    // Tag the active 'You' user row
    if (currentMemberId) {
      const rows = document.querySelectorAll('.member-management-row');
      rows.forEach((row) => {
        if (row.getAttribute('data-member-id') === currentMemberId) {
          const badge = row.querySelector('.member-you-badge');
          if (badge) badge.classList.remove('hidden');
        }
      });
    }

    // Trigger Add Member Submit
    if (addForm && addBtn) {
      addForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        hideAlert();
        addBtn.disabled = true;
        addBtn.textContent = 'Adding…';

        const nameInput = document.getElementById('new-member-name');
        const upiInput = document.getElementById('new-member-upi');
        const name = nameInput ? nameInput.value.trim() : '';
        const upiId = upiInput ? upiInput.value.trim() : '';

        try {
          const res = await fetch(`/api/trips/${code}/members`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name, upiId: upiId || null }),
          });

          const result = await res.json();
          if (!res.ok) {
            throw new Error(result.error || 'Failed to add member');
          }

          // Reload page to reflect changes
          window.location.reload();
        } catch (error) {
          addBtn.disabled = false;
          addBtn.textContent = 'Add Member';
          showAlert(error.message);
        }
      });
    }

    // Dynamic Row click actions (Save UPI or Delete Member)
    if (membersList) {
      membersList.addEventListener('click', async (e) => {
        const target = e.target;
        
        // 1. Check Save UPI Click
        if (target.classList.contains('save-upi-btn')) {
          hideAlert();
          const row = target.closest('.member-management-row');
          if (!row) return;
          const memberId = row.getAttribute('data-member-id');
          const input = row.querySelector('.upi-input-field');
          const upiId = input ? input.value.trim() : '';

          target.disabled = true;
          target.textContent = 'Saving';

          try {
            const res = await fetch(`/api/trips/${code}/members/${memberId}/upi`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ upiId: upiId || null })
            });

            const result = await res.json();
            if (!res.ok) {
              throw new Error(result.error || 'Failed to save UPI ID');
            }

            // Success feedback
            target.textContent = 'Saved!';
            target.className = "save-upi-btn bg-green-600 text-white text-[12px] font-sans font-medium px-md py-[6px] rounded-pill select-none shrink-0";
            setTimeout(() => {
              target.disabled = false;
              target.textContent = 'Save';
              target.className = "save-upi-btn bg-primary text-on-primary text-[12px] font-sans font-medium px-md py-[6px] rounded-pill hover:bg-primary-focus active:scale-95 transition-all select-none cursor-pointer shrink-0";
            }, 1500);

          } catch (error) {
            target.disabled = false;
            target.textContent = 'Save';
            showAlert(error.message);
          }
        }

        // 2. Check Delete Member Click
        if (target.classList.contains('remove-member-btn')) {
          hideAlert();
          const row = target.closest('.member-management-row');
          if (!row) return;
          const memberId = row.getAttribute('data-member-id');
          const memberName = row.getAttribute('data-member-name');

          if (memberId && memberName) {
            openRemoveMemberModal(memberId, memberName);
          }
        }
      });
    }

    // In-app Remove Member Modal Logic
    const removeModal = document.getElementById('remove-member-modal');
    const closeRemoveModalBtn = document.getElementById('close-remove-member-modal-btn');
    const cancelRemoveModalBtn = document.getElementById('cancel-remove-member-btn');
    const confirmRemoveMemberBtn = document.getElementById('confirm-remove-member-btn');
    const confirmRemoveMemberBtnText = document.getElementById('confirm-remove-member-btn-text');
    const removeMemberDesc = document.getElementById('remove-member-desc');
    const removeMemberModalError = document.getElementById('remove-member-modal-error');

    let pendingRemoveMemberId = null;

    function openRemoveMemberModal(memberId, memberName) {
      pendingRemoveMemberId = memberId;
      if (removeMemberDesc) {
        removeMemberDesc.textContent = `Are you sure you want to remove ${memberName} from this trip?`;
      }
      if (removeMemberModalError) removeMemberModalError.classList.add('hidden');
      if (confirmRemoveMemberBtn) confirmRemoveMemberBtn.disabled = false;
      if (confirmRemoveMemberBtnText) confirmRemoveMemberBtnText.textContent = 'Remove';
      if (removeModal) removeModal.classList.remove('hidden');
    }

    function closeRemoveMemberModal() {
      if (removeModal) removeModal.classList.add('hidden');
      pendingRemoveMemberId = null;
    }

    if (closeRemoveModalBtn) closeRemoveModalBtn.addEventListener('click', closeRemoveMemberModal);
    if (cancelRemoveModalBtn) cancelRemoveModalBtn.addEventListener('click', closeRemoveMemberModal);
    if (removeModal) {
      removeModal.addEventListener('click', (e) => {
        if (e.target === removeModal) closeRemoveMemberModal();
      });
    }
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && removeModal && !removeModal.classList.contains('hidden')) {
        closeRemoveMemberModal();
      }
    });

    if (confirmRemoveMemberBtn) {
      confirmRemoveMemberBtn.addEventListener('click', async () => {
        if (!pendingRemoveMemberId) return;

        confirmRemoveMemberBtn.disabled = true;
        if (confirmRemoveMemberBtnText) confirmRemoveMemberBtnText.textContent = 'Removing…';
        if (removeMemberModalError) removeMemberModalError.classList.add('hidden');

        try {
          const res = await fetch(`/api/trips/${code}/members/${pendingRemoveMemberId}`, {
            method: 'DELETE'
          });

          const result = await res.json();
          if (!res.ok) {
            throw new Error(result.error || 'Failed to remove member');
          }

          // If deleting oneself, clear local session token and redirect to join
          if (pendingRemoveMemberId === currentMemberId) {
            localStorage.removeItem(`split_yatra_member_${code}`);
            window.location.replace(`/trip/${code}/join`);
          } else {
            window.location.reload();
          }
        } catch (error) {
          confirmRemoveMemberBtn.disabled = false;
          if (confirmRemoveMemberBtnText) confirmRemoveMemberBtnText.textContent = 'Remove';
          if (removeMemberModalError) {
            removeMemberModalError.textContent = (error && error.message) ? error.message : 'An error occurred';
            removeMemberModalError.classList.remove('hidden');
          }
        }
      });
    }
  </script>
</Layout>
