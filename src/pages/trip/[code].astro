---
import Layout from '../../layouts/Layout.astro';
import SubNav from '../../components/SubNav.astro';
import { getTripByCode } from '../../lib/store';
import { formatINR, formatISTDate } from '../../lib/format';
import { computeNetBalances } from '../../lib/settlement';
import { generateQrCodeDataUrl } from '../../lib/upi';

const { code } = Astro.params;

if (!code) {
  return Astro.redirect('/');
}

const tripData = await getTripByCode(code);
if (!tripData) {
  return Astro.redirect('/trip/new'); // fallback if code doesn't exist
}

const { trip, members, expenses, shares } = tripData;
const netBalances = computeNetBalances(members, expenses, shares);

// Calculate total trip spending
const totalSpendPaise = expenses.reduce((acc, curr) => acc + curr.amountPaise, 0);

// Get last 5 expenses
const recentExpenses = [...expenses]
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
  .slice(0, 5);

// Pre-generate trip invite QR code for instant modal display
const inviteUrl = `${Astro.url.origin}/trip/${code}`;
let inviteQrDataUrl = '';
try {
  inviteQrDataUrl = await generateQrCodeDataUrl(inviteUrl);
} catch (e) {
  console.error('Failed to generate invite QR code for trip', e);
}
---

<Layout title={`${trip.name} Dashboard — SplitYatra`} noindex={true}>
  <!-- Identity Redirect Script (run immediately to block FOUC) -->
  <script define:vars={{ code }}>
    if (!localStorage.getItem(`split_yatra_member_${code}`)) {
      window.location.replace(`/trip/${code}/join`);
    }
  </script>

  <!-- SubNav frosted bar -->
  <SubNav code={code} activeTab="dashboard" tripName={trip.name} />

  <div class="bg-canvas-parchment min-h-[90vh] pb-[100px] sm:pb-xxl">
    <div class="max-w-[1440px] w-full mx-auto px-lg pt-lg grid grid-cols-1 lg:grid-cols-3 gap-lg">
      
      <!-- Left 2 Columns: Overall & Members -->
      <div class="lg:col-span-2 space-y-lg">
        
        <!-- Invite & Overall Spend Card -->
        <div class="bg-white border border-hairline rounded-lg p-lg shadow-sm flex flex-col md:flex-row justify-between items-start md:items-center gap-md">
          <div>
            <span class="text-caption text-ink-muted-48 uppercase tracking-wider font-semibold">Total Trip Spend</span>
            <div class="text-display-lg font-display text-ink font-semibold tracking-tight leading-none mt-[4px]">
              {formatINR(totalSpendPaise)}
            </div>
            <p class="text-caption text-ink-muted-48 mt-[6px]">
              Split among {members.length} member{members.length === 1 ? '' : 's'}.
            </p>
          </div>
          <div class="w-full md:w-auto bg-surface-pearl border border-hairline rounded-md p-sm flex items-center justify-between gap-md max-w-md">
            <div class="truncate cursor-pointer group" id="share-link-box" title="Click to copy link and open QR code">
              <span class="text-[11px] uppercase text-ink-muted-48 block font-semibold flex items-center gap-xs">
                <span>Share Trip Link</span>
                <span id="copy-hint" class="text-[10px] text-primary font-normal lowercase opacity-0 group-hover:opacity-100 transition-opacity">click for QR</span>
              </span>
              <span class="font-mono text-caption text-ink font-semibold truncate block select-all" id="share-link-text">
                Loading…
              </span>
            </div>
            <div class="flex items-center gap-xs shrink-0">
              <button 
                id="share-invite-btn"
                class="bg-primary text-on-primary text-[12px] font-sans font-medium px-md py-xs rounded-pill hover:bg-primary-focus active:scale-95 transition-all select-none cursor-pointer shrink-0 flex items-center gap-[6px]"
                title="Share & show QR code"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect width="5" height="5" x="3" y="3" rx="1"/><rect width="5" height="5" x="16" y="3" rx="1"/><rect width="5" height="5" x="3" y="16" rx="1"/><path d="M21 16h-3a2 2 0 0 0-2 2v3"/><path d="M21 21v.01"/><path d="M12 7v3a2 2 0 0 1-2 2H7"/><path d="M3 12h.01"/><path d="M12 3h.01"/><path d="M12 16v.01"/><path d="M16 12h1"/><path d="M21 12v.01"/><path d="M12 21v-1"/></svg>
                <span id="share-btn-text">Share & QR</span>
              </button>
              <a
                id="whatsapp-share-btn"
                href="#"
                target="_blank"
                rel="noopener noreferrer"
                class="bg-emerald-600 text-white text-[12px] font-sans font-medium px-md py-xs rounded-pill hover:bg-emerald-700 active:scale-95 transition-all select-none cursor-pointer shrink-0 flex items-center gap-[4px]"
                title="Share on WhatsApp"
              >
                <span>WhatsApp</span>
              </a>
            </div>
          </div>
        </div>

        <!-- Personal Balance Banner (Hydrated on Client) -->
        <div id="personal-balance-card" class="bg-white border border-hairline rounded-lg p-lg shadow-sm animate-pulse">
          <div class="h-16 bg-zinc-100 rounded-md"></div>
        </div>

        <!-- Group Member Ledger -->
        <div class="bg-white border border-hairline rounded-lg p-lg shadow-sm">
          <h2 class="text-body-strong font-semibold text-ink mb-md">Trip Ledger</h2>
          <div class="space-y-sm">
            {netBalances.map((mBal) => {
              const member = members.find((m) => m.id === mBal.memberId);
              const name = member ? member.name : 'Unknown';
              const upi = member?.upiId;
              
              let balText = '';
              let balClass = 'text-ink-muted-48';
              if (mBal.netBalancePaise > 0) {
                balText = `is owed ${formatINR(mBal.netBalancePaise)}`;
                balClass = 'text-green-600 font-semibold';
              } else if (mBal.netBalancePaise < 0) {
                balText = `owes ${formatINR(Math.abs(mBal.netBalancePaise))}`;
                balClass = 'text-red-500 font-semibold';
              } else {
                balText = 'is settled up';
              }

              return (
                <div 
                  class="member-ledger-row flex items-center justify-between p-sm border-b border-divider-soft last:border-0 hover:bg-surface-pearl rounded-sm transition-colors"
                  data-member-id={mBal.memberId}
                >
                  <div class="truncate pr-sm">
                    <span class="text-body-strong text-ink font-semibold flex items-center gap-xs">
                      <span class="truncate">{name}</span>
                      <span class="member-you-badge hidden text-fine-print bg-primary text-white px-xs py-[2px] rounded-xs text-[10px]">You</span>
                    </span>
                    {upi && (
                      <span class="text-caption text-ink-muted-48 block truncate">
                        upi: {upi}
                      </span>
                    )}
                  </div>
                  <div class="text-right shrink-0">
                    <div class={`${balClass} tabular-nums`}>{balText}</div>
                    <div class="text-fine-print text-ink-muted-48 tabular-nums">
                      Paid: {formatINR(mBal.totalPaidPaise)} &middot; Share: {formatINR(mBal.totalOwedPaise)}
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        </div>

      </div>

      <!-- Right Column: Recent Expenses -->
      <div class="space-y-lg">
        <div class="bg-white border border-hairline rounded-lg p-lg shadow-sm flex flex-col justify-between min-h-[350px]">
          <div>
            <div class="flex items-center justify-between mb-lg">
              <h2 class="text-body-strong font-semibold text-ink">Recent Expenses</h2>
              <a href={`/trip/${code}/history`} class="text-primary text-caption hover:underline">View All</a>
            </div>

            {recentExpenses.length === 0 ? (
              <div class="text-center py-xl text-ink-muted-48 flex flex-col items-center">
                <span class="text-[44px] mb-xs">💸</span>
                <p class="text-caption">No expenses recorded yet.</p>
                <a 
                  href={`/trip/${code}/expense/new`}
                  class="text-primary text-caption mt-sm font-semibold hover:underline"
                >
                  Add your first expense
                </a>
              </div>
            ) : (
              <div class="space-y-md">
                {recentExpenses.map((exp) => {
                  const payer = members.find((m) => m.id === exp.paidByMemberId);
                  const payerName = payer ? payer.name : 'Unknown';

                  return (
                    <a
                      href={`/trip/${code}/expense/${exp.id}/edit`}
                      class="flex items-center justify-between p-sm border border-hairline hover:border-primary rounded-md bg-surface-pearl text-left transition-all active:scale-98 select-none"
                    >
                      <div class="truncate pr-sm">
                        <span class="text-caption-strong text-ink font-semibold block truncate">
                          {exp.description}
                        </span>
                        <span class="text-fine-print text-ink-muted-48 block">
                          Paid by {payerName} &middot; {formatISTDate(exp.date)}
                        </span>
                        <!-- Category Tag -->
                        <span class="inline-block text-[9px] uppercase font-bold tracking-wider px-[6px] py-[2px] rounded-xs mt-[4px] bg-zinc-200 text-ink-muted-80 font-sans">
                          {exp.category}
                        </span>
                      </div>
                      <div class="text-body-strong text-ink font-semibold shrink-0 tabular-nums">
                        {formatINR(exp.amountPaise)}
                      </div>
                    </a>
                  );
                })}
              </div>
            )}
          </div>

          <!-- Add Expense Button (Desktop version) -->
          <a
            href={`/trip/${code}/expense/new`}
            class="hidden sm:block text-center bg-primary text-on-primary font-sans font-medium text-body w-full py-[12px] rounded-pill hover:bg-primary-focus active:scale-95 transition-all select-none cursor-pointer mt-lg"
          >
            + Add Expense
          </a>
        </div>
      </div>

    </div>
  </div>

  <!-- Floating Sticky Add Expense Button for Mobile -->
  <div class="sm:hidden fixed bottom-6 left-1/2 -translate-x-1/2 z-40 w-[90%] max-w-[340px]">
    <a
      href={`/trip/${code}/expense/new`}
      class="flex items-center justify-center gap-xs bg-primary text-on-primary font-sans font-semibold text-body py-[14px] rounded-pill shadow-xl active:scale-95 transition-all select-none cursor-pointer text-center"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
      Add Expense
    </a>
  </div>

  <!-- Trip Invite QR Code Modal -->
  <div id="invite-qr-modal" class="hidden fixed inset-0 bg-black/60 backdrop-blur-xs flex items-center justify-center z-50 p-lg">
    <div class="bg-white border border-hairline rounded-lg p-lg max-w-[380px] w-full text-center flex flex-col items-center shadow-2xl relative animate-fadeIn">
      <!-- Close button inside modal -->
      <button 
        id="close-invite-modal-btn"
        aria-label="Close modal"
        class="absolute right-md top-md w-8 h-8 rounded-full bg-zinc-100 hover:bg-zinc-200 text-ink flex items-center justify-center active:scale-90 transition-all select-none cursor-pointer"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
      </button>

      <span class="inline-block text-[11px] font-mono font-semibold bg-zinc-100 text-ink px-sm py-[2px] rounded-pill mb-xs border border-zinc-200">
        Trip Code: {code}
      </span>
      <h3 class="text-display-md font-display font-semibold text-ink tracking-tight mb-xxs">
        Scan to Join
      </h3>
      <p class="text-caption text-ink-muted-48 mb-md max-w-[280px]">
        Friends can scan with their phone camera to join <strong class="text-ink font-semibold">{trip.name}</strong>
      </p>

      <!-- QR Code Container -->
      <div class="bg-white border-2 border-zinc-100 rounded-lg p-sm mb-md w-[250px] h-[250px] flex items-center justify-center shadow-sm">
        {inviteQrDataUrl ? (
          <img id="invite-modal-qr-img" src={inviteQrDataUrl} alt={`QR code for ${trip.name}`} class="w-full h-full object-contain select-none" />
        ) : (
          <div class="text-caption text-ink-muted-48">Generating QR...</div>
        )}
      </div>

      <!-- Quick Actions -->
      <div class="w-full flex items-center gap-xs mb-sm">
        <button
          id="modal-copy-link-btn"
          type="button"
          class="flex-1 bg-primary text-on-primary text-[13px] font-sans font-medium py-xs px-sm rounded-pill hover:bg-primary-focus active:scale-95 transition-all cursor-pointer flex items-center justify-center gap-[6px]"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
          <span id="modal-copy-btn-text">Copy Link</span>
        </button>
        <a
          id="modal-whatsapp-btn"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="flex-1 bg-emerald-600 text-white text-[13px] font-sans font-medium py-xs px-sm rounded-pill hover:bg-emerald-700 active:scale-95 transition-all cursor-pointer flex items-center justify-center gap-[6px]"
        >
          <span>WhatsApp</span>
        </a>
      </div>

      <p class="text-fine-print text-ink-muted-48 leading-relaxed max-w-[300px]">
        No app install or login required. Works with any mobile camera or browser.
      </p>
    </div>
  </div>

  <!-- Client-side Hydration Script -->
  <script define:vars={{ code, netBalances, members, tripName: trip.name }}>
    // Resolve identity
    const currentMemberId = localStorage.getItem(`split_yatra_member_${code}`);
    
    // Set share link text and WhatsApp links
    const fullUrl = `${window.location.origin}/trip/${code}`;
    const linkEl = document.getElementById('share-link-text');
    if (linkEl) {
      linkEl.textContent = fullUrl;
    }

    const waText = encodeURIComponent(
      `Hey! Join our "${tripName}" ledger on SplitYatra to split our bills: ${fullUrl} (Code: ${code})`
    );
    const waUrl = `https://api.whatsapp.com/send?text=${waText}`;

    const waBtn = document.getElementById('whatsapp-share-btn');
    if (waBtn) {
      waBtn.href = waUrl;
    }

    const modalWaBtn = document.getElementById('modal-whatsapp-btn');
    if (modalWaBtn) {
      modalWaBtn.href = waUrl;
    }

    // Modal elements & state
    const inviteModal = document.getElementById('invite-qr-modal');
    const closeInviteModalBtn = document.getElementById('close-invite-modal-btn');
    const modalCopyBtn = document.getElementById('modal-copy-link-btn');
    const modalCopyBtnText = document.getElementById('modal-copy-btn-text');

    function openInviteModal() {
      if (inviteModal) {
        inviteModal.classList.remove('hidden');
      }
    }

    function closeInviteModal() {
      if (inviteModal) {
        inviteModal.classList.add('hidden');
      }
    }

    if (closeInviteModalBtn) {
      closeInviteModalBtn.addEventListener('click', closeInviteModal);
    }
    if (inviteModal) {
      inviteModal.addEventListener('click', (e) => {
        if (e.target === inviteModal) {
          closeInviteModal();
        }
      });
    }
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeInviteModal();
      }
    });

    // Copy to clipboard helper
    async function copyToClipboard(onSuccess) {
      try {
        if (navigator.clipboard && navigator.clipboard.writeText) {
          await navigator.clipboard.writeText(fullUrl);
        } else {
          const textArea = document.createElement('textarea');
          textArea.value = fullUrl;
          textArea.style.position = 'fixed';
          textArea.style.opacity = '0';
          document.body.appendChild(textArea);
          textArea.focus();
          textArea.select();
          document.execCommand('copy');
          document.body.removeChild(textArea);
        }
        if (onSuccess) onSuccess();
      } catch (err) {
        console.error('Failed to copy link:', err);
      }
    }

    // Modal Copy Link Button handler
    if (modalCopyBtn && modalCopyBtnText) {
      modalCopyBtn.addEventListener('click', () => {
        copyToClipboard(() => {
          modalCopyBtnText.textContent = 'Copied! ✓';
          modalCopyBtn.classList.remove('bg-primary', 'hover:bg-primary-focus');
          modalCopyBtn.classList.add('bg-green-600', 'hover:bg-green-700');

          setTimeout(() => {
            modalCopyBtnText.textContent = 'Copy Link';
            modalCopyBtn.classList.remove('bg-green-600', 'hover:bg-green-700');
            modalCopyBtn.classList.add('bg-primary', 'hover:bg-primary-focus');
          }, 2000);
        });
      });
    }

    // Share & Copy Handler (Dashboard button & box)
    async function handleShareOrCopy() {
      const shareBtn = document.getElementById('share-invite-btn');
      const shareBtnText = document.getElementById('share-btn-text');

      // 1. Copy link immediately
      copyToClipboard(() => {
        if (shareBtnText && shareBtn) {
          shareBtnText.textContent = 'Copied! ✓';
          shareBtn.classList.remove('bg-primary', 'hover:bg-primary-focus');
          shareBtn.classList.add('bg-green-600', 'hover:bg-green-700');

          setTimeout(() => {
            shareBtnText.textContent = 'Share & QR';
            shareBtn.classList.remove('bg-green-600', 'hover:bg-green-700');
            shareBtn.classList.add('bg-primary', 'hover:bg-primary-focus');
          }, 2000);
        }
      });

      // 2. Open QR Code Modal
      openInviteModal();
    }

    const shareBtn = document.getElementById('share-invite-btn');
    if (shareBtn) {
      shareBtn.addEventListener('click', handleShareOrCopy);
    }

    const shareBox = document.getElementById('share-link-box');
    if (shareBox) {
      shareBox.addEventListener('click', handleShareOrCopy);
    }

    // Hydrate 'You' badges in Ledger list
    if (currentMemberId) {
      const rows = document.querySelectorAll('.member-ledger-row');
      rows.forEach((row) => {
        if (row.getAttribute('data-member-id') === currentMemberId) {
          const badge = row.querySelector('.member-you-badge');
          if (badge) badge.classList.remove('hidden');
        }
      });
    }

    // Hydrate Personalized Balance Hero Card
    const personalCard = document.getElementById('personal-balance-card');
    if (personalCard && currentMemberId) {
      const myBal = netBalances.find((b) => b.memberId === currentMemberId);
      const myMember = members.find((m) => m.id === currentMemberId);
      const myName = myMember ? myMember.name : 'User';

      let markup = '';

      if (!myBal || myBal.netBalancePaise === 0) {
        markup = `
          <div class="flex items-center gap-md">
            <span class="text-[36px]">🎉</span>
            <div>
              <span class="text-caption text-ink-muted-48 uppercase font-semibold">Hey ${myName}</span>
              <h3 class="text-body-strong font-semibold text-ink text-[19px]">You are all settled up!</h3>
              <p class="text-caption text-ink-muted-48">Everything splits cleanly back to zero.</p>
            </div>
          </div>
        `;
      } else if (myBal.netBalancePaise > 0) {
        // Format manually for Client
        const rupees = (myBal.netBalancePaise / 100);
        const amtStr = new Intl.NumberFormat('en-IN', {
          style: 'currency',
          currency: 'INR',
          minimumFractionDigits: myBal.netBalancePaise % 100 === 0 ? 0 : 2
        }).format(rupees);

        markup = `
          <div class="flex items-center gap-md bg-green-50 border border-green-200 rounded-md p-md">
            <span class="text-[36px]">📈</span>
            <div>
              <span class="text-caption text-green-700 uppercase font-semibold">Hey ${myName}</span>
              <h3 class="text-display-md text-green-600 font-semibold leading-none tracking-tight my-[4px]">${amtStr}</h3>
              <p class="text-caption text-green-800">is owed to you overall from this trip.</p>
            </div>
          </div>
        `;
      } else {
        const rupees = Math.abs(myBal.netBalancePaise / 100);
        const amtStr = new Intl.NumberFormat('en-IN', {
          style: 'currency',
          currency: 'INR',
          minimumFractionDigits: myBal.netBalancePaise % 100 === 0 ? 0 : 2
        }).format(rupees);

        markup = `
          <div class="flex items-center gap-md bg-red-50 border border-red-200 rounded-md p-md">
            <span class="text-[36px]">📉</span>
            <div>
              <span class="text-caption text-red-700 uppercase font-semibold">Hey ${myName}</span>
              <h3 class="text-display-md text-red-500 font-semibold leading-none tracking-tight my-[4px]">${amtStr}</h3>
              <p class="text-caption text-red-800">is what you owe overall to settle up.</p>
            </div>
          </div>
        `;
      }

      personalCard.className = "bg-white border border-hairline rounded-lg p-lg shadow-sm";
      personalCard.innerHTML = markup;
    }
  </script>
</Layout>
