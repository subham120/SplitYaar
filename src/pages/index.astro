---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <!-- Section 1: Hero (Light / Canvas BG) -->
  <section class="bg-canvas py-12 sm:py-section px-3.5 sm:px-lg flex flex-col items-center text-center justify-center min-h-[75vh]">
    <div class="max-w-[800px] w-full flex flex-col items-center">
      <!-- Tagline -->
      <span class="text-primary font-semibold tracking-wide uppercase text-caption-strong mb-xs">
        SplitYatra 🇮🇳
      </span>
      
      <!-- Headline -->
      <h1 class="text-[36px] sm:text-hero-display font-display text-ink font-semibold tracking-tight leading-none mb-md select-none">
        Split trip expenses.<br/>
        Zero friction.
      </h1>
      
      <!-- Sub-headline -->
      <p class="text-[16px] sm:text-lead text-ink-muted-80 font-normal leading-relaxed max-w-[600px] mb-xl">
        A mobile-first expense splitter built for Indian friend groups. Settle roommate rent or travel expenses instantly via UPI. No email, no password, no signup.
      </p>
      
      <!-- CTAs -->
      <div class="flex flex-col sm:flex-row gap-3 sm:gap-md w-full sm:w-auto">
        <a 
          href="/trip/new" 
          class="bg-primary text-on-primary font-sans font-medium text-body px-xl py-3 sm:py-md rounded-pill hover:bg-primary-focus active:scale-95 transition-all text-center select-none cursor-pointer inline-block shadow-xs"
        >
          Start a New Trip
        </a>
        <button 
          id="join-trip-btn"
          class="border border-primary text-primary bg-transparent font-sans font-medium text-body px-xl py-3 sm:py-md rounded-pill active:scale-95 transition-all text-center select-none cursor-pointer inline-block"
        >
          Join Existing Trip
        </button>
      </div>

      <!-- Quick join form (hidden by default, toggled by JS) -->
      <div id="join-form-container" class="hidden mt-xl w-full max-w-sm p-4 sm:p-lg bg-canvas-parchment border border-hairline rounded-lg text-left animate-fadeIn shadow-sm">
        <h3 class="text-body-strong text-ink mb-sm font-semibold">Join with Trip Code</h3>
        <form id="join-trip-form" class="space-y-sm">
          <div>
            <label for="trip-code" class="block text-caption text-ink-muted-80 mb-xxs">8-character Trip Code or Link</label>
            <input 
              type="text" 
              id="trip-code" 
              name="code" 
              placeholder="e.g. A1B2C3D4 or paste trip link" 
              maxlength="120"
              required
              class="w-full bg-canvas text-ink font-sans text-body border border-hairline rounded-pill px-lg py-[10px] focus:outline-none focus:border-primary"
            />
          </div>
          <button 
            type="submit" 
            class="w-full bg-primary text-on-primary font-sans text-body py-[10px] rounded-pill hover:bg-primary-focus active:scale-95 transition-all select-none cursor-pointer"
          >
            Find Trip & Join
          </button>
          <p id="join-error" class="hidden text-caption text-red-600 mt-xs"></p>
        </form>
      </div>
    </div>
  </section>

  <!-- Section 2: Features (Parchment BG for rhythm change) -->
  <section class="bg-canvas-parchment py-12 sm:py-section px-3.5 sm:px-lg border-t border-hairline">
    <div class="max-w-[1440px] w-full mx-auto">
      <div class="text-center max-w-[800px] mx-auto mb-10 sm:mb-xxl">
        <h2 class="text-[26px] sm:text-display-lg text-ink font-display font-semibold mb-sm">Built for how Indian groups spend.</h2>
        <p class="text-caption sm:text-lead text-ink-muted-48 leading-relaxed">
          Forget spreadsheets and typing manually on WhatsApp. SplitYatra settles debts with the absolute minimum number of payments.
        </p>
      </div>
      
      <!-- Utility Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-lg">
        <!-- Card 1 -->
        <div class="bg-canvas border border-hairline rounded-lg p-5 sm:p-lg flex flex-col justify-between min-h-[200px] sm:min-h-[220px] shadow-xs">
          <div>
            <div class="text-[32px] mb-sm">⚡</div>
            <h3 class="text-body-strong text-ink font-semibold mb-xs">Log in 15 seconds</h3>
            <p class="text-caption text-ink-muted-48 leading-relaxed">
              No account creation needed. Open the link, type the details, select who paid, and add it. Keep the flow smooth.
            </p>
          </div>
        </div>

        <!-- Card 2 -->
        <div class="bg-canvas border border-hairline rounded-lg p-5 sm:p-lg flex flex-col justify-between min-h-[200px] sm:min-h-[220px] shadow-xs">
          <div>
            <div class="text-[32px] mb-sm">📉</div>
            <h3 class="text-body-strong text-ink font-semibold mb-xs">Greedy Debt Settlement</h3>
            <p class="text-caption text-ink-muted-48 leading-relaxed">
              Our algorithm simplifies payments so that no matter how many transactions occur, everyone settles up in at most N-1 transactions.
            </p>
          </div>
        </div>

        <!-- Card 3 -->
        <div class="bg-canvas border border-hairline rounded-lg p-5 sm:p-lg flex flex-col justify-between min-h-[200px] sm:min-h-[220px] shadow-xs">
          <div>
            <div class="text-[32px] mb-sm">💸</div>
            <h3 class="text-body-strong text-ink font-semibold mb-xs">UPI Integrated</h3>
            <p class="text-caption text-ink-muted-48 leading-relaxed">
              Scan a QR code or tap to open UPI apps (GPay, PhonePe, Paytm) directly with amount and notes pre-filled. Settle instantly.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 3: Dark Tile Accent Section (Tile BG for contrast) -->
  <section class="bg-surface-tile-1 text-on-dark py-12 sm:py-section px-3.5 sm:px-lg border-t border-zinc-800">
    <div class="max-w-[1440px] w-full mx-auto flex flex-col md:flex-row items-center justify-between gap-8 sm:gap-xl">
      <div class="max-w-[600px]">
        <span class="text-primary-on-dark font-semibold tracking-wide uppercase text-caption-strong mb-xs block">
          Designed with Privacy
        </span>
        <h2 class="text-[26px] sm:text-display-lg text-body-on-dark font-display font-semibold mb-md">
          Your expense history is yours.
        </h2>
        <p class="text-caption sm:text-lead text-body-muted leading-relaxed mb-lg">
          SplitYatra does not save cookie profiles, track browser behavior, or ask for email contacts. All transaction logs are kept private to your trip's shared invite code.
        </p>
        <a 
          href="/trip/new" 
          class="bg-primary text-on-primary font-sans font-medium text-body px-xl py-3 sm:py-md rounded-pill hover:bg-primary-focus active:scale-95 transition-all inline-block shadow-xs"
        >
          Create Free Trip
        </a>
      </div>
      
      <!-- Interactive QR / Mockup Element -->
      <div class="w-full max-w-[400px] bg-surface-tile-2 border border-zinc-800 p-lg rounded-lg flex flex-col items-center text-center">
        <div class="w-[180px] h-[180px] bg-white rounded-md flex items-center justify-center p-sm mb-lg shadow-lg">
          <!-- Stand-in visual QR -->
          <div class="w-full h-full border-4 border-dashed border-zinc-200 flex items-center justify-center text-zinc-400 font-sans text-caption font-bold">
            UPI QR CODE
          </div>
        </div>
        <h4 class="text-body-strong text-body-on-dark font-semibold mb-xxs">Scan to Pay</h4>
        <p class="text-caption text-body-muted max-w-[280px]">
          Scan with Google Pay, PhonePe or any Indian banking app to instantly pay your friend.
        </p>
      </div>
    </div>
  </section>

  <!-- Client Interaction script -->
  <script>
    // Toggle Join Form
    const joinBtn = document.getElementById('join-trip-btn');
    const formContainer = document.getElementById('join-form-container');
    const joinForm = document.getElementById('join-trip-form');
    const tripCodeInput = document.getElementById('trip-code') as HTMLInputElement | null;
    const errorEl = document.getElementById('join-error');

    if (joinBtn && formContainer) {
      joinBtn.addEventListener('click', () => {
        formContainer.classList.toggle('hidden');
        if (!formContainer.classList.contains('hidden') && tripCodeInput) {
          tripCodeInput.focus();
          formContainer.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      });
    }

    if (joinForm && tripCodeInput && errorEl) {
      joinForm.addEventListener('submit', (e) => {
        e.preventDefault();
        errorEl.classList.add('hidden');

        const raw = tripCodeInput.value.trim();
        // Extract 8-character code if user pasted a link or full URL
        const urlMatch = raw.match(/\/trip\/([A-Za-z0-9]{8})/i);
        let code = urlMatch ? urlMatch[1].toUpperCase() : raw.toUpperCase();
        
        // Strip non-alphanumeric characters
        code = code.replace(/[^A-Z0-9]/g, '');

        if (code.length !== 8) {
          errorEl.textContent = 'Please enter a valid 8-character trip code or paste a trip link.';
          errorEl.classList.remove('hidden');
          return;
        }

        // Navigate directly to the join page to verify existing user or register new user
        window.location.href = `/trip/${code}/join`;
      });
    }
  </script>
</Layout>
