---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = "SplitYatra — India's Sleekest Expense Splitter",
  description = "Split trip and roommate expenses with friends instantly. Zero login, automated debt simplification, and direct UPI pay links.",
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO & Privacy Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    
    <!-- Typography: Google Fonts Inter fallback for SF Pro -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
  </head>
  <body class="bg-canvas text-ink font-sans antialiased min-h-screen flex flex-col">
    <!-- Global Navigation (Apple-inspired thin black bar) -->
    <header class="bg-surface-black text-on-dark h-[44px] flex items-center justify-between px-lg text-nav-link font-sans select-none sticky top-0 z-50">
      <div class="max-w-[1440px] w-full mx-auto flex items-center justify-between">
        <!-- Logo / Branding -->
        <a href="/" class="flex items-center gap-xs font-semibold hover:opacity-80 transition-opacity">
          <span class="text-[14px]">✈️</span>
          <span class="tracking-tight text-[13px]">SplitYatra</span>
        </a>
        
        <!-- Navigation Links -->
        <div class="flex items-center gap-lg">
          <a href="/" class="hover:text-primary-on-dark transition-colors text-[12px] font-normal">Home</a>
          
          <!-- Local Trips Dropdown / Link -->
          <div class="relative group">
            <button id="nav-trips-btn" class="hover:text-primary-on-dark transition-colors text-[12px] font-normal flex items-center gap-[4px] cursor-pointer">
              My Trips
              <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
            </button>
            <div id="nav-trips-dropdown" class="hidden absolute right-0 mt-xs w-60 bg-surface-tile-1 border border-zinc-800 rounded-sm shadow-xl p-xs z-50 text-[12px] text-on-dark">
              <div class="font-semibold text-body-muted border-b border-zinc-800 pb-[6px] mb-[6px] px-xs">Recent Trips</div>
              <ul id="nav-trips-list" class="space-y-[4px]">
                <li class="px-xs py-[4px] text-body-muted italic">No trips loaded yet.</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- Main Content Container -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-canvas-parchment text-ink-muted-80 py-xxl px-lg text-fine-print border-t border-hairline mt-auto">
      <div class="max-w-[1440px] w-full mx-auto grid grid-cols-1 md:grid-cols-3 gap-xl">
        <div>
          <h4 class="text-caption-strong text-ink font-semibold mb-sm">SplitYatra 🇮🇳</h4>
          <p class="text-ink-muted-48 leading-relaxed max-w-[280px]">
            A premium, privacy-focused expense splitter built for Indian roommate groups and travelers. No accounts, no ads, no trackers.
          </p>
        </div>
        <div>
          <h4 class="text-caption-strong text-ink font-semibold mb-sm">Features</h4>
          <ul class="space-y-xs text-ink-muted-48">
            <li>✨ Greedy Debt Simplification</li>
            <li>📱 Mobile-first Interface</li>
            <li>💸 UPI Auto Pay & QR Codes</li>
            <li>🔒 Privacy First (Zero Login)</li>
          </ul>
        </div>
        <div>
          <h4 class="text-caption-strong text-ink font-semibold mb-sm">Instructions</h4>
          <p class="text-ink-muted-48 leading-relaxed">
            Create a trip, add friend names, and log expenses. Share the private trip code with your group. Settle up seamlessly via GPay, PhonePe, or Paytm.
          </p>
        </div>
      </div>
      <div class="max-w-[1440px] w-full mx-auto border-t border-hairline mt-xl pt-lg flex flex-col md:flex-row justify-between items-center gap-sm text-ink-muted-48">
        <div>&copy; {new Date().getFullYear()} SplitYatra. Made in India for effortless splitting.</div>
        <div class="flex gap-lg">
          <a href="/" class="hover:underline">Home</a>
          <span class="text-zinc-300">|</span>
          <span class="text-ink font-semibold">IST (Asia/Kolkata)</span>
        </div>
      </div>
    </footer>

    <!-- Client Script for Dropdown & Local Storage Trips -->
    <script>
      // Load trips from localStorage and display in dropdown
      function updateNavTrips() {
        const listEl = document.getElementById('nav-trips-list');
        if (!listEl) return;
        
        try {
          const trips = JSON.parse(localStorage.getItem('split_yatra_trips') || '[]');
          if (trips.length === 0) {
            listEl.innerHTML = '<li class="px-xs py-[4px] text-body-muted italic">No active trips</li>';
            return;
          }
          
          listEl.innerHTML = '';
          trips.forEach((trip: { code: string; name: string }) => {
            const li = document.createElement('li');
            const a = document.createElement('a');
            a.href = `/trip/${encodeURIComponent(trip.code)}`;
            a.className = 'block px-xs py-[6px] hover:bg-primary hover:text-white rounded-xs transition-colors truncate max-w-full';
            a.textContent = trip.name;
            li.appendChild(a);
            listEl.appendChild(li);
          });
        } catch (e) {
          console.error('Failed to parse local trips', e);
        }
      }

      // Dropdown toggle logic
      const btn = document.getElementById('nav-trips-btn');
      const dropdown = document.getElementById('nav-trips-dropdown');
      
      if (btn && dropdown) {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          dropdown.classList.toggle('hidden');
          updateNavTrips();
        });
        
        document.addEventListener('click', () => {
          dropdown.classList.add('hidden');
        });
      }

      // Prevent mouse wheel from accidentally changing number input values across all pages
      document.addEventListener('wheel', () => {
        if (
          document.activeElement &&
          document.activeElement instanceof HTMLInputElement &&
          document.activeElement.type === 'number'
        ) {
          document.activeElement.blur();
        }
      });
    </script>
  </body>
</html>
