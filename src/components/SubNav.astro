---
interface Props {
  code: string;
  activeTab: 'dashboard' | 'history' | 'members' | 'settlement';
  tripName: string;
}

const { code, activeTab, tripName } = Astro.props;

const links = [
  { id: 'dashboard', label: 'Dashboard', href: `/trip/${code}` },
  { id: 'history', label: 'History', href: `/trip/${code}/history` },
  { id: 'members', label: 'Members', href: `/trip/${code}/members` },
  { id: 'settlement', label: 'Settle Up', href: `/trip/${code}/settlement` },
];
---

<div class="sticky top-[44px] bg-canvas-parchment/80 backdrop-blur-md border-b border-hairline h-[52px] flex items-center z-40 select-none">
  <div class="max-w-[1440px] w-full mx-auto px-lg flex items-center justify-between gap-xs sm:gap-md">
    <!-- Left: Trip Title & Short Code -->
    <div class="flex items-center gap-xs truncate min-w-0">
      <span class="font-display text-[15px] sm:text-tagline font-semibold text-ink truncate max-w-[100px] xs:max-w-[160px] sm:max-w-[300px]">
        {tripName}
      </span>
      <span class="font-mono bg-zinc-200 text-ink px-sm py-[2px] rounded-xs text-[11px] sm:text-[12px] font-bold tracking-wider shrink-0" title={`Trip Code: ${code}`}>
        {code}
      </span>
    </div>
    
    <!-- Right: Nav links -->
    <nav class="flex items-center gap-xs sm:gap-lg overflow-x-auto no-scrollbar scroll-smooth">
      {links.map((link) => {
        const isActive = link.id === activeTab;
        return (
          <a
            href={link.href}
            class={`text-[12px] sm:text-button-utility transition-colors font-medium whitespace-nowrap py-[4px] px-[6px] border-b-2 ${
              isActive 
                ? 'text-primary border-primary font-semibold' 
                : 'text-ink-muted-48 border-transparent hover:text-ink'
            }`}
          >
            {link.label}
          </a>
        );
      })}
    </nav>
  </div>
</div>
