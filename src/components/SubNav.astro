---
interface Props {
  code: string;
  activeTab: 'dashboard' | 'history' | 'members' | 'settlement';
  tripName: string;
}

const { code, activeTab, tripName } = Astro.props;

const links = [
  { id: 'dashboard', label: 'Dashboard', href: `/trip/${code}` },
  { id: 'history', label: 'History', href: `/trip/${code}/history` },
  { id: 'members', label: 'Members', href: `/trip/${code}/members` },
  { id: 'settlement', label: 'Settle Up', href: `/trip/${code}/settlement` },
];
---

<div class="sticky top-[44px] bg-white/95 backdrop-blur-md border-b border-hairline z-40 select-none shadow-xs">
  <div class="max-w-[1440px] w-full mx-auto px-3.5 sm:px-lg py-2 flex flex-col sm:flex-row sm:items-center justify-between gap-1.5 sm:gap-md">
    <!-- Top Row on Mobile / Left on Desktop: Trip Title & Short Code -->
    <div class="flex items-center justify-between sm:justify-start gap-2 min-w-0">
      <div class="flex items-center gap-2 min-w-0">
        <span class="font-display text-[15px] sm:text-tagline font-bold text-ink truncate max-w-[200px] xs:max-w-[280px] sm:max-w-[340px]" title={tripName}>
          {tripName}
        </span>
        <button
          id="subnav-copy-code-btn"
          type="button"
          class="font-mono bg-zinc-100 hover:bg-zinc-200 active:scale-95 text-ink-muted-80 border border-zinc-300/70 px-2 py-[2px] rounded-xs text-[11px] font-bold tracking-wider shrink-0 flex items-center gap-1 transition-all cursor-pointer"
          title="Click to copy trip code"
          aria-label="Copy trip code"
        >
          <span>{code}</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
        </button>
      </div>
    </div>
    
    <!-- Tab Navigation: Smooth horizontal scrolling on mobile with clear active pill styling -->
    <nav class="flex items-center gap-1 sm:gap-1.5 overflow-x-auto no-scrollbar py-0.5 -mx-1 px-1">
      {links.map((link) => {
        const isActive = link.id === activeTab;
        return (
          <a
            href={link.href}
            class={`text-[12.5px] sm:text-[13px] transition-all font-medium whitespace-nowrap py-1 px-2.5 sm:px-3 rounded-pill text-center ${
              isActive 
                ? 'bg-primary text-white font-semibold shadow-xs' 
                : 'text-ink-muted-48 hover:text-ink hover:bg-zinc-100'
            }`}
          >
            {link.label}
          </a>
        );
      })}
    </nav>
  </div>
</div>

<script define:vars={{ code }}>
  const subnavCopyBtn = document.getElementById('subnav-copy-code-btn');
  if (subnavCopyBtn) {
    subnavCopyBtn.addEventListener('click', async () => {
      try {
        if (navigator.clipboard && navigator.clipboard.writeText) {
          await navigator.clipboard.writeText(code);
        } else {
          const ta = document.createElement('textarea');
          ta.value = code;
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.select();
          document.execCommand('copy');
          document.body.removeChild(ta);
        }
        const span = subnavCopyBtn.querySelector('span');
        if (span) {
          const orig = span.textContent;
          span.textContent = 'Copied!';
          subnavCopyBtn.classList.add('text-green-600', 'border-green-300');
          setTimeout(() => {
            span.textContent = orig;
            subnavCopyBtn.classList.remove('text-green-600', 'border-green-300');
          }, 1500);
        }
      } catch (e) {
        console.error(e);
      }
    });
  }
</script>

