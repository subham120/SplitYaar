{
	"version": 3,
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/trips/([^/]+?)/expenses/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/trips/([^/]+?)/expenses/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/trips/([^/]+?)/members/([^/]+?)/upi/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/trips/([^/]+?)/members/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/trips/([^/]+?)/members/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/trips/([^/]+?)/settlement/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/trips/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/trips/?$",
			"dest": "_render"
		},
		{
			"src": "^/trip/new/?$",
			"dest": "_render"
		},
		{
			"src": "^/trip/([^/]+?)/expense/new/?$",
			"dest": "_render"
		},
		{
			"src": "^/trip/([^/]+?)/expense/([^/]+?)/edit/?$",
			"dest": "_render"
		},
		{
			"src": "^/trip/([^/]+?)/history/?$",
			"dest": "_render"
		},
		{
			"src": "^/trip/([^/]+?)/join/?$",
			"dest": "_render"
		},
		{
			"src": "^/trip/([^/]+?)/members/?$",
			"dest": "_render"
		},
		{
			"src": "^/trip/([^/]+?)/settlement/?$",
			"dest": "_render"
		},
		{
			"src": "^/trip/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		},
		{
			"src": "^/404/?$",
			"dest": "_render"
		},
		{
			"src": "^/.*$",
			"dest": "_render",
			"status": 404
		}
	]
}